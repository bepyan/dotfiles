[user]
	name = bepyan
	email = bepyan@naver.com
[core]
	precomposeunicode = true
	quotepath = false
[pull]
	rebase = false
[http]
	postBuffer = 1048576000
[push]
	autoSetupRemote = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# gitdir follows .git, so worktrees still match ~/kakao/ and ~/vscode/.
[includeIf "gitdir:~/kakao/"]
	path = ~/.config/git/kakao
[includeIf "gitdir:~/vscode/"]
	path = ~/.config/git/vscode
